# Copy to the repo root as .env  (copy 00_setup\.env.example .env)
# .env is git-ignored. Never commit real values.

# --- Snowflake -------------------------------------------------------------
# Account identifier ORGNAME-ACCOUNTNAME (Snowsight: your name → Account → Copy account identifier)
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
# Your human user for dev work; switch to SVC_RETAIL_PIPELINE for prod-like runs
SNOWFLAKE_USER=DESMOND
SNOWFLAKE_PRIVATE_KEY_PATH=C:/Users/Admin/.snowflake/keys/desmond_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=change-me
SNOWFLAKE_ROLE=RETAIL_ENGINEER
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
# Snowflake CLI reads this name for encrypted private keys
PRIVATE_KEY_PASSPHRASE=change-me

# dbt dev schema suffix: your models build into RETAIL_DEV.DBT_<suffix>_*
DBT_DEV_SCHEMA_SUFFIX=desmond

# --- Google Cloud ----------------------------------------------------------
GCP_PROJECT_ID=YOUR_PROJECT_ID
GCP_REGION=us-central1
GCS_LANDING_BUCKET=YOUR_PROJECT_ID-landing
GCS_LAKEHOUSE_BUCKET=YOUR_PROJECT_ID-lakehouse

# --- Alerts (optional) -----------------------------------------------------
# Slack incoming-webhook URL for Airflow notifications; leave empty to log only
SLACK_WEBHOOK_URL=
