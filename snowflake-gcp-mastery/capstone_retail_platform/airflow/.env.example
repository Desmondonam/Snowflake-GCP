# Copy to capstone_retail_platform/airflow/.env (git-ignored). Astro loads it into every container.
# The pipeline runs as the SERVICE user created in Stage 1 (key-pair auth, no password login).
# Put the private key at airflow/include/keys/svc_retail_pipeline_rsa_key.p8 (include/keys is git-ignored).
# Keep each value on ONE line and do not wrap it in quotes.

# Airflow connection used by SqlSensor / SQLExecuteQueryOperator. "password" = the private key PASSPHRASE.
AIRFLOW_CONN_SNOWFLAKE_DEFAULT={"conn_type":"snowflake","login":"SVC_RETAIL_PIPELINE","password":"change-me","schema":"POS","extra":{"account":"ORGNAME-ACCOUNTNAME","warehouse":"TRANSFORM_WH","database":"RETAIL_RAW","role":"RETAIL_ENGINEER","private_key_file":"/usr/local/airflow/include/keys/svc_retail_pipeline_rsa_key.p8"}}

# dbt profile variables (same names as the repo-root .env)
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=SVC_RETAIL_PIPELINE
SNOWFLAKE_PRIVATE_KEY_PATH=/usr/local/airflow/include/keys/svc_retail_pipeline_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=change-me
SNOWFLAKE_ROLE=RETAIL_ENGINEER
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH

# Optional Slack incoming webhook; empty = messages are written to the task log instead
SLACK_WEBHOOK_URL=
