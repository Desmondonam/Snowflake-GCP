# Snowflake CLI configuration.
# Copy to %USERPROFILE%\.snowflake\config.toml and fill in the values.
# The private key passphrase is NOT stored here: set the PRIVATE_KEY_PASSPHRASE environment variable.

default_connection_name = "retail"

[connections.retail]
account = "ORGNAME-ACCOUNTNAME"
user = "DESMOND"
authenticator = "SNOWFLAKE_JWT"
private_key_file = "C:/Users/Admin/.snowflake/keys/desmond_rsa_key.p8"
role = "SYSADMIN"
warehouse = "LAB_WH"

# Same identity, but working as the engineer role (use with: snow sql -c retail_engineer ...)
[connections.retail_engineer]
account = "ORGNAME-ACCOUNTNAME"
user = "DESMOND"
authenticator = "SNOWFLAKE_JWT"
private_key_file = "C:/Users/Admin/.snowflake/keys/desmond_rsa_key.p8"
role = "RETAIL_ENGINEER"
warehouse = "TRANSFORM_WH"

# Account-level admin work (integrations, resource monitors). Use sparingly.
[connections.retail_admin]
account = "ORGNAME-ACCOUNTNAME"
user = "DESMOND"
authenticator = "SNOWFLAKE_JWT"
private_key_file = "C:/Users/Admin/.snowflake/keys/desmond_rsa_key.p8"
role = "ACCOUNTADMIN"
warehouse = "LAB_WH"
